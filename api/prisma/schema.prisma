generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id            String   @id @default(uuid())
  itemName      String
  amount        Float
  sellerMomo    String
  buyerName     String?
  buyerPhone    String?
  buyerEmail    String?
  deliveryHours Int      @default(72)
  state         String   @default("CREATED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  disputes      Dispute[]
}

model LedgerEntry {
  id            String      @id @default(uuid())
  transactionId String
  entryType     String
  account       String
  amount        Float
  reference     String?
  note          String?
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Dispute {
  id               String      @id @default(uuid())
  transactionId    String
  reason           String
  reasonCategory   String      @default("OTHER")
  evidence         String?
  sellerResponse   String?
  raisedBy         String
  status           String      @default("OPEN")
  decision         String?
  decisionReason   String?
  decidedBy        String?
  approvedBy       String?
  decidedAt        DateTime?
  responseDeadline DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  transaction      Transaction      @relation(fields: [transactionId], references: [id])
  auditLogs        DisputeAuditLog[]
}

model DisputeAuditLog {
  id          String   @id @default(uuid())
  disputeId   String
  action      String
  performedBy String
  note        String?
  createdAt   DateTime @default(now())

  dispute     Dispute  @relation(fields: [disputeId], references: [id])
}